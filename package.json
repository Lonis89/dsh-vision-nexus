{
  "name": "dsh-vision-nexus",
  "version": "1.0.0",
  "description": "多引擎视觉增强工具插件：本地 CV 引擎 + 远端 VL 路由引擎，自动降级、渐进式工具挂载、会话隔离 Artifact、完整审计，含 DSH 原生侧边设置面板。",
  "type": "module",
  "author": "dsh-vision-nexus",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "runtime/cv_worker.py",
    "manifest.json",
    "cordis.patch.yml",
    "README.md",
    "README.PANEL.md",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown --config tsdown.config.ts",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "pnpm pack --dry-run"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "vision",
    "cv",
    "vl",
    "ocr",
    "settings-panel",
    "cordis"
  ]
}
