{
  "name": "dsh-vision-nexus",
  "version": "0.1.0",
  "description": "A unified vision capability hub for DSH agents: multi-backend scheduling, 14 image tools, a visual workbench, and fine-grained governance.",
  "type": "module",
  "icon": "icon.svg",
  "author": {
    "name": "Lonis89",
    "url": "https://github.com/Lonis89"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Lonis89/dsh-vision-nexus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lonis89/dsh-vision-nexus.git"
  },
  "bugs": {
    "url": "https://github.com/Lonis89/dsh-vision-nexus/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/**/*.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:self": "node scripts/build.mjs",
    "gen:locales": "node --experimental-strip-types scripts/gen-locales.mjs",
    "smoke": "node --experimental-strip-types scripts/smoke.mjs",
    "test": "node scripts/run-all-tests.mjs",
    "test:backend": "node --experimental-strip-types scripts/smoke.mjs",
    "test:frontend": "node --experimental-strip-types scripts/render-check.mjs",
    "test:client-load": "node scripts/client-load-check.mjs",
    "test:boundaries": "node scripts/check-boundaries.mjs",
    "test:dsh-contract": "node --experimental-strip-types scripts/check-dsh-contract.mjs",
    "test:encoding": "node scripts/check-encoding.mjs",
    "test:sequential": "npm run test:backend && npm run test:frontend && npm run test:boundaries && npm run test:dsh-contract && npm run test:encoding",
    "check": "node scripts/check-package.mjs",
    "check:imports": "node scripts/verify-imports.mjs",
    "check:build": "node scripts/verify-build.mjs",
    "check:readme": "node scripts/verify-readme.mjs",
    "prepublishOnly": "node scripts/build.mjs && node scripts/check-package.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "vision",
    "multimodal",
    "ocr",
    "object-detection",
    "ollama",
    "tesseract",
    "openai-compatible",
    "cordis",
    "react"
  ],
  "packageManager": "pnpm@11.7.0"
}
