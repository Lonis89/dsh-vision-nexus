node_modules/
pnpm-lock.yaml.bak
.npm/

# 构建输出：由 `node scripts/build.mjs` 生成，发布走 npm 的 files 字段。
# 是否纳入版本库取决于工作流：见 README「发布到 GitHub」一节。
# 默认忽略，由 CI 或 Release 流程产出。
lib/

# TypeScript 增量信息
*.tsbuildinfo
.tsbuildinfo

# ─────────────────────────────────────────────────────────────────
# 密钥与本地配置（绝不提交）
# ─────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json
credentials.json

# DSH 运行期数据（配置、缓存、日志、快照）
.dsh/
vision-nexus-data/

# ─────────────────────────────────────────────────────────────────
# 操作系统与编辑器
# ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo

